# ==============================================================================
# HD MOVIES - Environment Configuration
# ==============================================================================

# Site URL (used for canonical URLs, OpenGraph, and sitemap generation)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cron Job Secret
# A random secret token used by Vercel Cron to authorize daily sync requests.
# Generate with: openssl rand -hex 32
CRON_SECRET=your_super_secret_cron_token_here_32_chars

# Supabase / PostgreSQL Database Configuration
# Create a free project at https://supabase.com and run schema.sql in the SQL Editor.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# DMCA & Legal Contact
NEXT_PUBLIC_DMCA_EMAIL=dmca@hdmovies.org

# Advertising Network (Optional)
# Enter your Google AdSense Publisher Client ID (starts with ca-pub-)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-0000000000000000
